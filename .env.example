# Never commit a real key. This file is only a safe template.
GEMINI_API_KEY=
# Stable, general-purpose models to try in order. The backend discovers models
# available to this API key and skips unavailable or non-text models.
GEMINI_MODEL_PREFERENCES=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-latest
# Avoid a long chain of expensive/slow retries during a live demo.
GEMINI_MAX_MODEL_ATTEMPTS=3

# Optional threat-intelligence enrichment. Leave blank to use privacy-preserving
# local URL heuristics and TLS checks only. These keys must never reach the UI.
WEB_RISK_API_KEY=
VIRUSTOTAL_API_KEY=
URL_INTELLIGENCE_ENABLED=true
URL_TLS_PROBE_ENABLED=true
URL_ANALYSIS_TIMEOUT_SECONDS=5

# Raw .eml authentication checks. DKIM verification requires DNS access; a
# missing result is reported as NOT_VERIFIABLE rather than treated as a failure.
EMAIL_DKIM_VERIFICATION_ENABLED=true
EMAIL_DNS_TIMEOUT_SECONDS=4

# Comma-separated browser origins. Do not use * in a deployed app.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Keep true for the hackathon so a known phishing message still receives a
# transparent rules-based analysis if the AI provider is unavailable.
ENABLE_OFFLINE_FALLBACK=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Vercel production: use a shared Upstash REST Redis limit, so limits cannot be
# bypassed by landing on a different serverless instance. Local development uses
# a process-local limiter when these are blank.
DAILY_ANONYMOUS_LIMIT=120
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_BACKEND_TIMEOUT_SECONDS=2
RATE_LIMIT_FAIL_OPEN=false
TRUST_PROXY_HEADERS=true

# Bound concurrent paid AI calls and never send evidence text to monitoring.
PROVIDER_MAX_CONCURRENT_REQUESTS=4
PROVIDER_QUEUE_WAIT_SECONDS=3
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Media is opt-in. Consented uploads are processed in memory, sent only to the
# configured Gemini provider for text extraction, and are never saved by this app.
# Limits stay below Vercel's function-payload ceiling.
MEDIA_UPLOAD_ENABLED=true
MAX_REQUEST_BYTES=3250000
MAX_IMAGE_UPLOAD_BYTES=3000000
MAX_AUDIO_UPLOAD_BYTES=3000000
MAX_IMAGE_PIXELS=20000000
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_MIME_TYPES=audio/mpeg,audio/wav,audio/webm,audio/mp4,audio/x-m4a
